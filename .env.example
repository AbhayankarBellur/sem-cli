# Google Gemini API Key for optional AI-assisted interpretation
GEMINI_API_KEY=your_gemini_api_key_here

# Enable or disable AI features globally (default: false)
SEM_AI_ENABLED=false

# Root data directory for SQLite database and clones (default: ~/.sem-cli)
SEM_DATA_DIR=~/.sem-cli

# Color output toggle (1 to disable colors)
# NO_COLOR=1
